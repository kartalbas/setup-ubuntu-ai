{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local AI (llama-server)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "REPLACE_WITH_YOUR_API_KEY"
      },
      "models": {
        "qwen3.6-27b-IQ4_XS-pure.gguf": {
          "name": "Qwen3.6 27B (IQ4_XS, 100k TurboQuant)",
          "interleaved": {
            "field": "reasoning_content"
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 100000,
            "output": 32000
          }
        }
      }
    }
  },
  "model": "local-ai/qwen3.6-27b-IQ4_XS-pure.gguf"
}
