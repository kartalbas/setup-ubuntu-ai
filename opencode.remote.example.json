{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Remote LLM (platform ingress)",
      "options": {
        "baseURL": "https://llm.example.com/v1",
        "apiKey": "REPLACE_WITH_YOUR_API_KEY"
      },
      "models": {
        "Ternary-Bonsai-2-27B-PQ2_0.gguf": {
          "name": "Bonsai 2 27B (ternary, 262k, vision)",
          "interleaved": {
            "field": "reasoning_content"
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "local-ai/Ternary-Bonsai-2-27B-PQ2_0.gguf"
}
