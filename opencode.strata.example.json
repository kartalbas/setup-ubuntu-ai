{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata (Qwen3.8-Flash-Next)",
      "options": {
        "baseURL": "http://REPLACE_WITH_THE_SERVER_IP:8080/v1",
        "apiKey": "REPLACE_WITH_YOUR_API_KEY"
      },
      "models": {
        "qwen3.8-flash-next-unsloth-ud-q5_k_xl": {
          "name": "Qwen3.8-Flash-Next UD-Q5_K_XL (Strata, 262k, vision)",
          "interleaved": {
            "field": "reasoning_content"
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
