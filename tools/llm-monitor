#!/usr/bin/env bash
# tools/llm-monitor — the LLM server's vital signs, refreshed in place:
# RAM, GPU memory/temperature/power/load, CPU load/clock/temperatures,
# RAM-module temperatures, and what the server is doing. Read-only; Ctrl-C ends it.
#   tools/llm-monitor          every 3 s
#   tools/llm-monitor 1        every second
set -uo pipefail
INTERVAL="${1:-3}"
PORT="${LLAMA_PORT:-8080}"

# hwmon_temp NAME LABEL — °C of the sensor whose hwmon name and label match.
hwmon_temp() {
  local h f
  for h in /sys/class/hwmon/hwmon*; do
    [[ "$(cat "$h/name" 2>/dev/null)" == "$1" ]] || continue
    for f in "$h"/temp*_label; do
      [[ "$(cat "$f" 2>/dev/null)" == "$2" ]] || continue
      awk '{printf "%.0f", $1 / 1000}' "${f%_label}_input" 2>/dev/null; return 0
    done
  done
  printf '–'
}

# dimm_temps — every DDR5 module's own sensor (spd5118), "41 42".
dimm_temps() {
  local h out=""
  for h in /sys/class/hwmon/hwmon*; do
    [[ "$(cat "$h/name" 2>/dev/null)" == spd5118 ]] || continue
    out+="$(awk '{printf "%.0f", $1 / 1000}' "$h/temp1_input" 2>/dev/null) "
  done
  printf '%s' "${out:-–}"
}

# bar VALUE MAX — a 30-cell bar, green / yellow from 70 % / red from 90 % of MAX.
bar() {
  awk -v u="$1" -v t="$2" 'BEGIN { w = 30; f = (t > 0) ? u / t : 0; if (f > 1) f = 1; if (f < 0) f = 0
    n = int(f * w + 0.5); c = (f >= 0.9) ? 31 : (f >= 0.7) ? 33 : 32
    s = ""; for (i = 0; i < w; i++) s = s (i < n ? "█" : "░"); printf "\033[%dm%s\033[0m", c, s }'
}

# cpu_ticks — "busy total" jiffies of all CPUs since boot (/proc/stat).
cpu_ticks() { awk '/^cpu / {t=0; for (i=2; i<=NF; i++) t+=$i; print t-$5-$6, t}' /proc/stat; }

trap 'tput cnorm 2>/dev/null; echo; exit 0' INT TERM
tput civis 2>/dev/null
clear
read -r cb0 ct0 < <(cpu_ticks)
while :; do
  read -r cb1 ct1 < <(cpu_ticks)
  cpu_pct="$(awk -v b=$((cb1 - cb0)) -v t=$((ct1 - ct0)) 'BEGIN {printf "%.0f", (t > 0) ? b / t * 100 : 0}')"
  cb0=$cb1; ct0=$ct1
  read -r l1 l5 l15 _ < /proc/loadavg
  mhz="$(awk '/^cpu MHz/ {s+=$4; n++; if ($4 > m) m=$4} END {if (n) printf "%.0f avg / %.0f max MHz", s/n, m}' /proc/cpuinfo)"
  read -r mt ma < <(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {print t, a}' /proc/meminfo)
  mu=$(( mt - ma ))
  IFS=', ' read -r gname gmu gmt gtemp gpow glim gutil < <(nvidia-smi \
    --query-gpu=name,memory.used,memory.total,temperature.gpu,power.draw,power.limit,utilization.gpu \
    --format=csv,noheader,nounits 2>/dev/null | sed 's/NVIDIA GeForce //; s/ /_/g; s/,_/, /g')
  health="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:${PORT}/health" 2>/dev/null)"
  svc="$(systemctl is-active strata-server 2>/dev/null || true)"
  [[ "$svc" == active ]] || svc="$(systemctl is-active llama-server 2>/dev/null || echo '–')"
  ram_g="$(awk -v k="$mu" 'BEGIN{printf "%.1f", k/1048576}')"; ramt_g="$(awk -v k="$mt" 'BEGIN{printf "%.1f", k/1048576}')"
  gmu_g="$(awk -v m="${gmu:-0}" 'BEGIN{printf "%.1f", m/1024}')"; gmt_g="$(awk -v m="${gmt:-0}" 'BEGIN{printf "%.1f", m/1024}')"
  mhz_avg="${mhz%% *}"; tctl="$(hwmon_temp k10temp Tctl)"; ccd1="$(hwmon_temp k10temp Tccd1)"; ccd2="$(hwmon_temp k10temp Tccd2)"
  num() { [[ "$1" =~ ^[0-9.]+$ ]] && printf '%s' "$1" || printf 0; }
  printf '\033[H'
  printf '\033[1m LLM server  %s\033[0m   every %ss   (Ctrl-C ends)\033[K\n' "$(date '+%F %T')" "$INTERVAL"
  printf '\033[K\n\033[1m GPU  %s\033[0m\033[K\n' "${gname//_/ }"
  printf '  %-10s %s  %5.1f / %5.1f GiB\033[K\n' "memory" "$(bar "${gmu:-0}" "${gmt:-0}")" "$gmu_g" "$gmt_g"
  printf '  %-10s %s  %5s %%\033[K\n' "load" "$(bar "$(num "${gutil:-0}")" 100)" "${gutil:-–}"
  printf '  %-10s %s  %5s / %s W\033[K\n' "power" "$(bar "$(num "${gpow:-0}")" "$(num "${glim:-0}")")" "${gpow:-–}" "${glim:-–}"
  printf '  %-10s %s  %5s °C\033[K\n' "temp" "$(bar "$(num "${gtemp:-0}")" 90)" "${gtemp:-–}"
  printf '\033[K\n\033[1m CPU  %s threads\033[0m\033[K\n' "$(nproc)"
  printf '  %-10s %s  %5s %%   load avg %s %s %s\033[K\n' "load" "$(bar "$cpu_pct" 100)" "$cpu_pct" "$l1" "$l5" "$l15"
  printf '  %-10s %s  %5s MHz avg (max %s)\033[K\n' "clock" "$(bar "$(num "$mhz_avg")" 5700)" "${mhz_avg:-–}" "$(awk '{print $4}' <<<"$mhz")"
  printf '  %-10s %s  %5s °C\033[K\n' "temp Tctl" "$(bar "$(num "$tctl")" 95)" "$tctl"
  printf '  %-10s %s  %5s °C\033[K\n' "temp CCD1" "$(bar "$(num "$ccd1")" 95)" "$ccd1"
  printf '  %-10s %s  %5s °C\033[K\n' "temp CCD2" "$(bar "$(num "$ccd2")" 95)" "$ccd2"
  printf '\033[K\n\033[1m RAM\033[0m\033[K\n'
  printf '  %-10s %s  %5.1f / %5.1f GiB\033[K\n' "used" "$(bar "$mu" "$mt")" "$ram_g" "$ramt_g"
  i=0; for d in $(dimm_temps); do i=$((i + 1))
    printf '  %-10s %s  %5s °C\033[K\n' "temp DIMM$i" "$(bar "$(num "$d")" 85)" "$d"
  done
  printf '\033[K\n  %-10s %s, /health %s on :%s\033[K\n\033[J' "server" "$svc" "${health:-–}" "$PORT"
  sleep "$INTERVAL"
done
