#!/usr/bin/env bash
# tools/llm-monitor — the LLM server's vital signs, refreshed in place:
# RAM, GPU memory/temperature/power/load, CPU load/clock/temperatures,
# RAM-module temperatures, what the model is doing (state, tokens per second
# writing and reading, context in use, drafts accepted — from the server's
# /metrics; the API key is read once from the service credential with sudo, or
# from $LLAMA_API_KEY), and — for Strata — how the
# engine reads its model files from disk: the lookup (PLE) table it keeps on
# the SSD, how it opened it (O_DIRECT bypasses the page cache), how much of it
# is cached, how fast and how often it reads, when it last did, and what the
# disk under it is doing. Read-only; Ctrl-C ends it.
#   tools/llm-monitor          every 3 s
#   tools/llm-monitor 1        every second
set -uo pipefail
INTERVAL="${1:-3}"
PORT="${LLAMA_PORT:-8080}"
KEY="${LLAMA_API_KEY:-$(sudo -n head -1 /etc/setup-ubuntu-ai/api-key 2>/dev/null || true)}"

# hwmon_temp NAME LABEL — °C of the sensor whose hwmon name and label match.
hwmon_temp() {
  local h f
  for h in /sys/class/hwmon/hwmon*; do
    [[ "$(cat "$h/name" 2>/dev/null)" == "$1" ]] || continue
    for f in "$h"/temp*_label; do
      [[ "$(cat "$f" 2>/dev/null)" == "$2" ]] || continue
      awk '{printf "%.0f", $1 / 1000}' "${f%_label}_input" 2>/dev/null; return 0
    done
  done
  printf '–'
}

# dimm_temps — every DDR5 module's own sensor (spd5118), "41 42".
dimm_temps() {
  local h out=""
  for h in /sys/class/hwmon/hwmon*; do
    [[ "$(cat "$h/name" 2>/dev/null)" == spd5118 ]] || continue
    out+="$(awk '{printf "%.0f", $1 / 1000}' "$h/temp1_input" 2>/dev/null) "
  done
  printf '%s' "${out:-–}"
}

# bar VALUE MAX — a 30-cell bar, green / yellow from 70 % / red from 90 % of MAX.
bar() {
  awk -v u="$1" -v t="$2" 'BEGIN { w = 30; f = (t > 0) ? u / t : 0; if (f > 1) f = 1; if (f < 0) f = 0
    n = int(f * w + 0.5); c = (f >= 0.9) ? 31 : (f >= 0.7) ? 33 : 32
    s = ""; for (i = 0; i < w; i++) s = s (i < n ? "█" : "░"); printf "\033[%dm%s\033[0m", c, s }'
}

# engine_pid — the Strata engine (or llama-server) process.
engine_pid() { pgrep -x strata 2>/dev/null | head -1 || true; }

# engine_files PID — the model files the engine holds open: "path flags" lines.
engine_files() {
  local fd t n
  for fd in /proc/"$1"/fd/*; do
    t="$(readlink "$fd" 2>/dev/null)" || continue
    [[ "$t" == *.gguf || "$t" == */experts.bin ]] || continue
    n="${fd##*/}"
    printf '%s %s\n' "$t" "$(awk '/^flags:/ {print $2}' "/proc/$1/fdinfo/$n" 2>/dev/null)"
  done | sort -u
}

# io_counters PID — "read_bytes syscr" of the process (storage reads, read calls).
io_counters() { awk '/^read_bytes:/ {b=$2} /^syscr:/ {c=$2} END {print b+0, c+0}' "/proc/$1/io" 2>/dev/null || echo "0 0"; }

# disk_of FILE — the whole disk under FILE (sda for /dev/sda2).
disk_of() {
  local src; src="$(df --output=source "$1" 2>/dev/null | tail -1)"
  lsblk -no pkname "$src" 2>/dev/null | head -1 || basename "$src"
}

# disk_stat DISK — "reads sectors_read read_ms io_ms" since boot.
disk_stat() { awk '{print $1, $3, $4, $10}' "/sys/block/$1/stat" 2>/dev/null || echo "0 0 0 0"; }

human() { awk -v b="$1" 'BEGIN { split("B KB MB GB TB", u); i = 1; while (b >= 1000 && i < 5) { b /= 1000; i++ }
  printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i] }'; }

# cpu_ticks — "busy total" jiffies of all CPUs since boot (/proc/stat).
cpu_ticks() { awk '/^cpu / {t=0; for (i=2; i<=NF; i++) t+=$i; print t-$5-$6, t}' /proc/stat; }

trap 'tput cnorm 2>/dev/null; echo; exit 0' INT TERM
tput civis 2>/dev/null
clear
read -r cb0 ct0 < <(cpu_ticks)
epid=""; erb0=0; ecr0=0; last_read=""; dsk=""; dr0=0; ds0=0; dm0=0; dio0=0; t0=$(date +%s.%N)
while :; do
  t1=$(date +%s.%N); dt="$(awk -v a="$t0" -v b="$t1" 'BEGIN {d = b - a; print (d > 0) ? d : 1}')"; t0=$t1
  read -r cb1 ct1 < <(cpu_ticks)
  cpu_pct="$(awk -v b=$((cb1 - cb0)) -v t=$((ct1 - ct0)) 'BEGIN {printf "%.0f", (t > 0) ? b / t * 100 : 0}')"
  cb0=$cb1; ct0=$ct1
  read -r l1 l5 l15 _ < /proc/loadavg
  mhz="$(awk '/^cpu MHz/ {s+=$4; n++; if ($4 > m) m=$4} END {if (n) printf "%.0f avg / %.0f max MHz", s/n, m}' /proc/cpuinfo)"
  read -r mt ma < <(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {print t, a}' /proc/meminfo)
  mu=$(( mt - ma ))
  IFS=', ' read -r gname gmu gmt gtemp gpow glim gutil < <(nvidia-smi \
    --query-gpu=name,memory.used,memory.total,temperature.gpu,power.draw,power.limit,utilization.gpu \
    --format=csv,noheader,nounits 2>/dev/null | sed 's/NVIDIA GeForce //; s/ /_/g; s/,_/, /g')
  health="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:${PORT}/health" 2>/dev/null)"
  svc="$(systemctl is-active strata-server 2>/dev/null || true)"
  [[ "$svc" == active ]] || svc="$(systemctl is-active llama-server 2>/dev/null || echo '–')"
  ram_g="$(awk -v k="$mu" 'BEGIN{printf "%.1f", k/1048576}')"; ramt_g="$(awk -v k="$mt" 'BEGIN{printf "%.1f", k/1048576}')"
  gmu_g="$(awk -v m="${gmu:-0}" 'BEGIN{printf "%.1f", m/1024}')"; gmt_g="$(awk -v m="${gmt:-0}" 'BEGIN{printf "%.1f", m/1024}')"
  mhz_avg="${mhz%% *}"; tctl="$(hwmon_temp k10temp Tctl)"; ccd1="$(hwmon_temp k10temp Tccd1)"; ccd2="$(hwmon_temp k10temp Tccd2)"
  num() { [[ "$1" =~ ^[0-9.]+$ ]] && printf '%s' "$1" || printf 0; }
  printf '\033[H'
  printf '\033[1m LLM server  %s\033[0m   every %ss   (Ctrl-C ends)\033[K\n' "$(date '+%F %T')" "$INTERVAL"
  printf '\033[K\n\033[1m GPU  %s\033[0m\033[K\n' "${gname//_/ }"
  printf '  %-10s %s  %5.1f / %5.1f GiB\033[K\n' "memory" "$(bar "${gmu:-0}" "${gmt:-0}")" "$gmu_g" "$gmt_g"
  printf '  %-10s %s  %5s %%\033[K\n' "load" "$(bar "$(num "${gutil:-0}")" 100)" "${gutil:-–}"
  printf '  %-10s %s  %5s / %s W\033[K\n' "power" "$(bar "$(num "${gpow:-0}")" "$(num "${glim:-0}")")" "${gpow:-–}" "${glim:-–}"
  printf '  %-10s %s  %5s °C\033[K\n' "temp" "$(bar "$(num "${gtemp:-0}")" 90)" "${gtemp:-–}"
  printf '\033[K\n\033[1m CPU  %s threads\033[0m\033[K\n' "$(nproc)"
  printf '  %-10s %s  %5s %%   load avg %s %s %s\033[K\n' "load" "$(bar "$cpu_pct" 100)" "$cpu_pct" "$l1" "$l5" "$l15"
  printf '  %-10s %s  %5s MHz avg (max %s)\033[K\n' "clock" "$(bar "$(num "$mhz_avg")" 5700)" "${mhz_avg:-–}" "$(awk '{print $4}' <<<"$mhz")"
  printf '  %-10s %s  %5s °C\033[K\n' "temp Tctl" "$(bar "$(num "$tctl")" 95)" "$tctl"
  printf '  %-10s %s  %5s °C\033[K\n' "temp CCD1" "$(bar "$(num "$ccd1")" 95)" "$ccd1"
  printf '  %-10s %s  %5s °C\033[K\n' "temp CCD2" "$(bar "$(num "$ccd2")" 95)" "$ccd2"
  printf '\033[K\n\033[1m RAM\033[0m\033[K\n'
  printf '  %-10s %s  %5.1f / %5.1f GiB\033[K\n' "used" "$(bar "$mu" "$mt")" "$ram_g" "$ramt_g"
  i=0; for d in $(dimm_temps); do i=$((i + 1))
    printf '  %-10s %s  %5s °C\033[K\n' "temp DIMM$i" "$(bar "$(num "$d")" 85)" "$d"
  done
  printf '\033[K\n  %-10s %s, /health %s on :%s\033[K\n\033[J' "server" "$svc" "${health:-–}" "$PORT"
  # --- the model: what it is doing and how fast (Strata's /metrics JSON)
  m="$(curl -s --max-time 2 ${KEY:+-H "Authorization: Bearer ${KEY}"} "http://127.0.0.1:${PORT}/metrics" 2>/dev/null)"
  if jq -e '.live' >/dev/null 2>&1 <<<"$m"; then
    IFS=$'\t' read -r st ph pt gen mx tks tkm pfm req out reuse ptot dro dra < <(jq -r '[
      .live.state // "idle", (.live.phase // "" | .[0:48]), .live.prompt_tokens // 0, .live.generated // 0,
      .live.max_tokens // 0, .live.tok_s // 0, .live.tok_s_mean // 0, .live.prefill_tok_s_mean // 0,
      .totals.requests // 0, .totals.output_tokens // 0, .totals.reused // 0, .totals.prompt_tokens // 0,
      .totals.drafts_offered // 0, .totals.drafts_accepted // 0] | @tsv' <<<"$m")
    ctx="$(curl -s --max-time 2 ${KEY:+-H "Authorization: Bearer ${KEY}"} "http://127.0.0.1:${PORT}/v1/models" 2>/dev/null \
      | jq -r '.data[0].context_length // .data[0].max_model_len // 262144' 2>/dev/null)"
    printf '\033[K\n\033[1m LLM  %s\033[0m  %s\033[K\n' "$st" "$ph"
    printf '  %-10s %s  %5.1f tok/s   (mean %.1f)\033[K\n' "writing" "$(bar "$tks" 100)" "$tks" "$tkm"
    printf '  %-10s %s  %5.0f tok/s   (prompt read, mean)\033[K\n' "reading" "$(bar "$pfm" 4000)" "$pfm"
    printf '  %-10s %s  %6s / %s tokens\033[K\n' "context" "$(bar "$pt" "${ctx:-262144}")" "$pt" "${ctx:-262144}"
    printf '  %-10s %s  %6s / %s tokens\033[K\n' "answer" "$(bar "$gen" "${mx:-1}")" "$gen" "$mx"
    printf '  %-10s %s  %5s %%   of %s drafted tokens accepted\033[K\n' "drafts" \
      "$(bar "$dra" "$dro")" "$(awk -v a="$dra" -v o="$dro" 'BEGIN {printf "%.0f", (o > 0) ? a / o * 100 : 0}')" "$dro"
    printf '  %-10s %s requests, %s tokens written, %s of %s prompt tokens from cache\033[K\n' "since start" \
      "$req" "$out" "$reuse" "$ptot"
  fi

  # --- the engine's model files and the disk under them
  p="$(engine_pid)"
  if [[ -n "$p" ]]; then
    read -r erb ecr < <(io_counters "$p")
    if [[ "$p" != "$epid" ]]; then epid=$p; erb0=$erb; ecr0=$ecr; last_read=""; fi
    files="$(engine_files "$p")"
    ple="$(awk '{print $1}' <<<"$files" | grep -m1 -- '-00003-of-' || awk 'NR == 1 {print $1}' <<<"$files")"
    [[ -n "$ple" && -z "$dsk" ]] && { dsk="$(disk_of "$ple")"; read -r dr0 ds0 dm0 dio0 < <(disk_stat "$dsk"); }
    rate="$(awk -v d=$((erb - erb0)) -v t="$dt" 'BEGIN {printf "%.0f", d / t}')"
    calls="$(awk -v d=$((ecr - ecr0)) -v t="$dt" 'BEGIN {printf "%.0f", d / t}')"
    (( erb > erb0 )) && last_read=$(date +%s)
    erb0=$erb; ecr0=$ecr
    printf '\033[K\n\033[1m MODEL FILES  engine pid %s, up %s\033[0m\033[K\n' "$p" "$(ps -o etime= -p "$p" | tr -d ' ')"
    while read -r f fl; do
      [[ -n "$f" ]] || continue
      size="$(stat -c %s "$f" 2>/dev/null || echo 0)"
      if (( (8#${fl:-0} & 8#40000) != 0 )); then mode="O_DIRECT (no page cache)"; else
        res="$(fincore -b -n -o RES "$f" 2>/dev/null | tr -d ' ')"; mode="cached $(awk -v r="${res:-0}" -v s="$size" 'BEGIN {printf "%.0f", (s > 0) ? r / s * 100 : 0}') %"; fi
      printf '  %-10s %s  %s\033[K\n' "$( [[ "$f" == "$ple" ]] && echo 'PLE table' || echo 'open')" "$(human "$size")" "${f##*/}  ·  ${mode}"
    done <<<"$files"
    printf '  %-10s %s  %8s/s  %6s reads/s\033[K\n' "reading" "$(bar "$rate" 2000000000)" "$(human "$rate")" "$calls"
    if [[ -n "$last_read" ]]; then ago=$(( $(date +%s) - last_read )); lr="$( (( ago < 1 )) && echo 'now' || echo "${ago}s ago")"; else lr="not since the monitor started"; fi
    printf '  %-10s %s   ·  since start %s in %s read calls\033[K\n' "last read" "$lr" "$(human "$erb")" "$ecr"
    if [[ -n "$dsk" ]]; then
      read -r dr ds dm dio < <(disk_stat "$dsk")
      drate="$(awk -v s=$((ds - ds0)) -v t="$dt" 'BEGIN {printf "%.0f", s * 512 / t}')"
      diops="$(awk -v r=$((dr - dr0)) -v t="$dt" 'BEGIN {printf "%.0f", r / t}')"
      dutil="$(awk -v m=$((dio - dio0)) -v t="$dt" 'BEGIN {u = m / (t * 10); printf "%.0f", (u > 100) ? 100 : u}')"
      dlat="$(awk -v m=$((dm - dm0)) -v r=$((dr - dr0)) 'BEGIN {printf (r > 0) ? "%.2f ms" : "–", (r > 0) ? m / r : 0}')"
      dr0=$dr; ds0=$ds; dm0=$dm; dio0=$dio
      printf '  %-10s %s  %5s %%   %s/s, %s IOPS, %s per read  (/dev/%s, %s)\033[K\n' "disk busy" "$(bar "$dutil" 100)" "$dutil" \
        "$(human "$drate")" "$diops" "$dlat" "$dsk" "$(cat "/sys/block/$dsk/device/model" 2>/dev/null | xargs)"
    fi
    printf '\033[J'
  fi
  sleep "$INTERVAL"
done
