Strata v0.1.44.1: a GGUF shard without tensors is not "short".

check_shards() and whole_shard() want every shard to reach the aligned start of
its tensor data. A metadata-only shard never does: Unsloth's
Qwen3.8-Flash-Next-UD-Q5_K_XL-00001-of-00006.gguf is 10,946,618 bytes, its
aligned data start 10,946,624, so setup stops on a correct download (size and
SHA-256 match Strata's own pin). Upstream: issues #2346 #2470 #2587, fixes
#2505 #2632 (not merged as of 2026-10-16). Drop this patch once a release has it.

diff --git a/setup.py b/setup.py
index 8bb6ef9b..0083e09f 100644
--- a/setup.py
+++ b/setup.py
@@ -1704,6 +1704,8 @@ def whole_shard(s: Path) -> bool:
     from gguf_reader import GGUFFile
     try:
         g = GGUFFile(s)
+        if not g.tensors:                              # metadata only: the aligned data start need not exist on disk
+            return True
         return s.stat().st_size >= g.data_start + max((t.offset + (t.expected_bytes() or 0) for t in g.tensors),
                                                      default=0)
     except (OSError, ValueError, struct.error):
@@ -1952,6 +1954,8 @@ def check_shards(shards):
             g = GGUFFile(s)
         except (ValueError, struct.error) as e:
             fail(f"{s.name} is not a whole GGUF shard ({e})", "delete it and run setup again")
+        if not g.tensors:                              # metadata only (UD-Q5_K_XL's first shard): the aligned data
+            continue                                   # start need not exist on disk; its size and SHA-256 are pinned
         need = g.data_start + max((t.offset + (t.expected_bytes() or 0) for t in g.tensors), default=0)
         have = s.stat().st_size
         if have < need:
